# Quelora Widget — CDN Release Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# Cloudflare account ID — found in the dashboard right sidebar
CF_ACCOUNT_ID=PLACEHOLDER

# R2 API token credentials
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Permissions needed: Object Read & Write on bucket "quelora-cdn"
R2_ACCESS_KEY_ID=PLACEHOLDER
R2_SECRET_ACCESS_KEY=PLACEHOLDER

# R2 bucket name (must match wrangler.toml)
R2_BUCKET_NAME=quelora-cdn
